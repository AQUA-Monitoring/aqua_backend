# =============================================================================
#  Ambiente de Produção — aqua-prod
#  Copie para .env e ajuste os valores com credenciais reais
#  Mantém todas as variáveis do ambiente original
# =============================================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings
DEBUG=0
DJANGO_SECRET_KEY=<gerar-com: python -c "import secrets; print(secrets.token_urlsafe(64))">

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Production serves Flood Monitoring directly and keeps the demo enabled.
FLOOD_CAMERA_API_MODE=direct
FLOOD_CAMERA_DEDICATED_QUEUE=0

# Metricas privadas para o Prometheus do Aqua Ops. O token deve ser exatamente
# o mesmo conteudo do secret montado/configurado no scraper.
INTERNAL_METRICS_ENABLED=1
INTERNAL_METRICS_TOKEN=<mesmo-conteudo-do-secret-do-prometheus>

# Database (PostgreSQL)
DB_ENGINE=postgres
DB_HOST=db
DB_NAME=aqua_prod
DB_USER=aqua_prod
DB_PASSWORD=<sua-senha-prod>

# Postgres Container env (usado pelo serviço db)
POSTGRES_DB=aqua_prod
POSTGRES_USER=aqua_prod
POSTGRES_PASSWORD=<sua-senha-prod>

# Portas do Docker Compose
WEB_PORT=8090
DB_PORT=5433

# Remote API Sync
API_URL=https://api-aqua.michalski.app
API_EMAIL=<email-real>
API_PASSWORD=<senha-real>

# Mercado Pago (token de produção)
ACCESS_TOKEN=<seu-token-mercadopago>

# Google Drive ID do modelo de ML
FLOOD_MODEL_DRIVE_ID=<seu-drive-id>

# Demo determinística — serviço padrão em produção
DEMO_ENABLED=1
DEMO_CONTROL_TOKEN=<gere-um-token-aleatorio-forte>
DEMO_DYNAMIC_VIDEO_ATTACHMENT_KEY=<attachment-key-do-video-automatico>
DEMO_NORMAL_VIDEO_ATTACHMENT_KEY=<attachment-key-do-video-normal>
DEMO_FLOODED_VIDEO_ATTACHMENT_KEY=<attachment-key-do-video-alagado>
DEMO_SCENARIO_PATH=/demo-assets/scenario.json
DEMO_WORK_DIR=/tmp/aqua-demo-stream
DEMO_PREDICTION_CACHE_SECONDS=30
DEMO_STREAM_INTERNAL_URL=http://demo-stream:8089
DEMO_STREAM_MEDIA_INTERNAL_BASE_URL=http://demo-stream:8088
DEMO_STREAM_PUBLIC_URL=https://<host-publico>:8188/hls/playlist.m3u8
DEMO_STREAM_PORT=8188

# Limites do uploader (10 MiB para imagens; 300 MiB para vídeos)
UPLOADER_IMAGE_MAX_BYTES=10485760
UPLOADER_VIDEO_MAX_BYTES=314572800

# Web Push — habilite somente após provisionar as chaves VAPID
WEB_PUSH_ENABLED=0
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:<email-operacional>
WEB_PUSH_TTL_SECONDS=3600
WEB_PUSH_MAX_ATTEMPTS=5
UNIFIED_NOTIFICATIONS_ENABLED=1
