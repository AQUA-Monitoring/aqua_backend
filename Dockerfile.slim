FROM python:3.13-slim AS common

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Django and the Geo stack shared by every local service. Video and ML
# packages intentionally live in their own stages below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin libgdal-dev \
    libgeos-dev \
    libmagic1 \
    proj-bin libproj-dev \
    build-essential gcc && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.runtime.base.txt /tmp/requirements.runtime.base.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.runtime.base.txt


FROM common AS base

COPY manage.py ./
COPY config ./config
COPY core ./core
COPY scripts ./scripts

EXPOSE 8090

ENV DJANGO_SETTINGS_MODULE=config.settings

CMD ["python", "manage.py", "runserver", "0.0.0.0:8090"]


FROM common AS demo

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

COPY manage.py ./
COPY config ./config
COPY core ./core
COPY scripts ./scripts
COPY demo_assets/scenario.json /demo-assets/scenario.json

ENV DJANGO_SETTINGS_MODULE=config.settings


FROM common AS flood-dependencies

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxrender1 libxext6 libgl1 \
    ffmpeg && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.runtime.flood.txt /tmp/requirements.runtime.flood.txt
RUN pip install --no-cache-dir \
    -r /tmp/requirements.runtime.flood.txt \
    --extra-index-url https://download.pytorch.org/whl/cpu


FROM flood-dependencies AS flood

COPY manage.py ./
COPY config ./config
COPY core ./core
COPY scripts ./scripts

EXPOSE 8091

ENV DJANGO_SETTINGS_MODULE=config.settings

CMD ["python", "manage.py", "runserver", "0.0.0.0:8091"]


# Production Compose uses this final target. It retains the current complete
# Flood Monitoring behavior while development can select smaller targets.
FROM flood AS full
